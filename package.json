{
  "name": "fitpulse",
  "version": "1.0.0",
  "private": true,
  "description": "FitPulse - frontend (Vite/React) + backend (Express) on one Vercel project",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "morgan": "^1.10.0",
    "nodemailer": "^10.5.0"
  }
}
