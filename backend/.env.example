# ============================================
# FitPulse Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ----- Server -----
PORT=5001
NODE_ENV=development

# ----- MongoDB -----
MONGO_URI=mongodb://127.0.0.1:27017/fitness_tracker_db

# ----- JWT Authentication -----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# In production set this to your deployed frontend URL only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Email / SMTP (Nodemailer) -----
# Leave blank in development to use console simulation mode (links logged to terminal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM="FitPulse Team" <no-reply@fitpulse.internal>

# ----- Frontend URL (used in email links) -----
FRONTEND_URL=http://localhost:5173

